# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1,testserver
CORS_ALLOW_ALL=True

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5002
DB_NAME=nutrition_connect
DB_USER=nc_app
DB_PASSWORD=change_me_dev
# Optional single-string URL (overrides individual fields if your app supports it)
DATABASE_URL=postgresql://nc_app:change_me_dev@localhost:5002/nutrition_connect

# JWT lifetimes
JWT_ACCESS_LIFETIME_MIN=30
JWT_REFRESH_LIFETIME_DAYS=7

# Channels
CHANNEL_BACKEND=channels.layers.InMemoryChannelLayer
