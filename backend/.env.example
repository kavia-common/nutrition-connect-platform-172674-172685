# Backend environment example for Nutrition Connect

# Enable Supabase Auth for backend
USE_SUPABASE_AUTH=true

# Supabase credentials (do NOT include service role key here)
SUPABASE_URL=https://nznsixbvloaorucujewu.supabase.co
SUPABASE_ANON_KEY=<TO_BE_FILLED_BY_USER_OR_DEPLOYER>

# JWKS (JSON Web Key Set) URL for verifying Supabase JWTs
SUPABASE_JWKS_URL=https://nznsixbvloaorucujewu.supabase.co/auth/v1/.well-known/jwks.json

# Storage settings
SUPABASE_STORAGE_ENABLED=false
SUPABASE_STORAGE_BUCKET=uploads

# Intentionally left blank – must never be committed. Only set in secure environments if needed.
SUPABASE_SERVICE_ROLE_KEY=
