# Django settings
SECRET_KEY=dev-insecure-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.kavia.ai

# Database (platform_database uses 5002)
DB_HOST=localhost
DB_PORT=5002
DB_NAME=nutrition_connect
DB_USER=nc_app
DB_PASSWORD=change_me_dev

# JWT lifetimes
JWT_ACCESS_LIFETIME_MIN=30
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL=True

# Channels (in-memory by default)
CHANNEL_BACKEND=channels.layers.InMemoryChannelLayer
# If using Redis:
# CHANNEL_BACKEND=channels_redis.core.RedisChannelLayer
# REDIS_URL=redis://localhost:6379/0

# Supabase Auth
USE_SUPABASE_AUTH=true
SUPABASE_URL=<YOUR_SUPABASE_URL>
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_JWKS_URL=<YOUR_SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_ENABLED=false
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_SERVICE_ROLE_KEY=
