# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1,testserver
CORS_ALLOW_ALL=True

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5001
