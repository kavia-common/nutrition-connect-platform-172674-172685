# Django settings
SECRET_KEY=change-me-dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database (platform_database expected on 127.0.0.1:5002)
DB_HOST=127.0.0.1
DB_PORT=5002
DB_NAME=nc_app
DB_USER=nc_app
DB_PASSWORD=nc_app

# Channels / WebSocket (defaults OK)
# CHANNEL_BACKEND=channels_redis.core.RedisChannelLayer
# REDIS_URL=redis://localhost:6379/0

# JWT lifetimes (optional)
JWT_ACCESS_LIFETIME_MIN=30
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL=True

# Supabase auth (optional; keep false unless configured)
USE_SUPABASE_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json

# Storage (currently disabled)
SUPABASE_STORAGE_ENABLED=false
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_SERVICE_ROLE_KEY=
