# Django
DEBUG=True
# Replace with a strong random value for production
SECRET_KEY=CHANGE_ME_DEV_ONLY_SECRET
# Allow common hosts; append additional hosts as needed
ALLOWED_HOSTS=.kavia.ai,localhost,127.0.0.1

# Database (Preview defaults)
# Preview environment: database service is platform_database on port 5001
DB_HOST=platform_database
DB_PORT=5001
DB_NAME=nc_app
DB_USER=nc_app
DB_PASSWORD=nc_app
DB_CONN_MAX_AGE=60

# Local development override (uncomment as needed)
# DB_HOST=127.0.0.1
# DB_PORT=5002

# Channels (websockets) - keep in-memory by default
CHANNEL_BACKEND=channels.layers.InMemoryChannelLayer
# If using Redis for channels:
# CHANNEL_BACKEND=channels_redis.core.RedisChannelLayer
# REDIS_URL=redis://localhost:6379/0

# JWT lifetimes
JWT_ACCESS_LIFETIME_MIN=30
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL=True

# Supabase (optional)
USE_SUPABASE_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_ENABLED=false
SUPABASE_STORAGE_BUCKET=uploads
# Never commit the service role key
SUPABASE_SERVICE_ROLE_KEY=
